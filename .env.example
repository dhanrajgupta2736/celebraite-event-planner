# CelebrAIte - Environment Configuration
# Copy this file to .env and insert your Google Gemini API Key

# Gemini API Key (Get yours free at https://aistudio.google.com/app/apikey)
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Default Gemini Model (defaults to gemini-3.8-flash)
VITE_GEMINI_MODEL=gemini-3.8-flash
